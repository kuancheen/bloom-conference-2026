# Environment variables for local tooling
# Copy to .env and fill in real values — this file stays gitignored.

# Your Google Apps Script Web App /exec URL (from Deploy → Manage Deployments)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Drive Folder ID where payment receipts are uploaded
# (find it in the URL of your folder: /folders/THIS_PART)
DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID
