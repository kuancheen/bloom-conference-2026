# Environment variables for local tooling & deployment
# Copy to .env and fill in real values — this file stays gitignored.

# Your Google Apps Script Web App /exec URL (from Deploy → Manage Deployments)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Drive Folder ID where payment receipts are uploaded
DRIVE_FOLDER_ID=YOUR_DRIVE_FOLDER_ID

# Production SFTP Deployment Credentials (Gitignored)
SFTP_USER=actschurchconference-admin
SFTP_HOST=188.166.188.97
SFTP_PASS=your_sftp_password_here
SFTP_REMOTE_BLOOM_DIR=/srv/users/actschurchconference-admin/apps/actschurchconference/public/bloom2026
SFTP_REMOTE_PUBLIC_ROOT=/srv/users/actschurchconference-admin/apps/actschurchconference/public
